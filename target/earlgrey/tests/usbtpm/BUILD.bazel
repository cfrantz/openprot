load("@pigweed//pw_kernel/tooling:app_package.bzl", "app_package")
load("@pigweed//pw_kernel/tooling:system_image.bzl", "system_image")
load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//target/earlgrey:defs.bzl", "TARGET_COMPATIBLE_WITH")
load("//target/earlgrey/signing/keys:defs.bzl", "FPGA_ECDSA_KEY", "SILICON_ECDSA_KEY")
load("//target/earlgrey/tooling:opentitan_runner.bzl", "opentitan_test")

# The TPM Service Application
app_package(
    name = "app_tpm_service",
    app_name = "tpm_service",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    visibility = ["//visibility:public"],
)

# The USB TPM Bridge Application
app_package(
    name = "app_usb_tpm_bridge",
    app_name = "usb_tpm_bridge",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    visibility = ["//visibility:public"],
)

system_image(
    name = "usbtpm",
    apps = [
        "//services/tpm:tpm_service",
        "//protocol/usb/usbtpm:usb_tpm_bridge",
    ],
    kernel = ":target",
    platform = "//target/earlgrey",
    system_config = ":system_config",
    tags = ["kernel"],
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    template = "//target/earlgrey:linker_script_template",
)

filegroup(
    name = "system_config",
    srcs = ["system.json5"],
    visibility = ["//visibility:public"],
)

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/riscv:arch_riscv",
    system_config = ":system_config",
)

rust_binary(
    name = "target",
    srcs = [
        "target.rs",
    ],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/earlgrey:entry",
        "//target/earlgrey:console",
        "@pigweed//pw_kernel/arch/riscv:arch_riscv",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
    ],
)

opentitan_test(
    name = "usbtpm_hyper310_test",
    ecdsa_key = FPGA_ECDSA_KEY,
    interface = "hyper310",
    tags = [
        "hardware",
        "hyper310",
    ],
    target = ":usbtpm",
)

opentitan_test(
    name = "usbtpm_hyper340_test",
    ecdsa_key = FPGA_ECDSA_KEY,
    interface = "hyper340",
    tags = [
        "hardware",
        "hyper340",
    ],
    target = ":usbtpm",
)

opentitan_test(
    name = "usbtpm_silicon_test",
    ecdsa_key = SILICON_ECDSA_KEY,
    interface = "teacup",
    tags = [
        "earlgrey_silicon",
        "hardware",
    ],
    target = ":usbtpm",
)
