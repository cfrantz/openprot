{
  arch: {
    type: "riscv",
  },
  kernel: {
    flash_start_address: 0xA0010000,
    flash_size_bytes: 40960,         // 32K
    ram_start_address: 0x10000000,
    ram_size_bytes: 0x8000,         // 32K
    interrupt_table: {
      table: {}
    },
  },
  apps: [
    {
      name: "cryptolib",
      flash_size_bytes: 65536, // 16K
      ram_size_bytes: 12288,    // 4K
      process: {
        name: "cryptolib server",
        memory_mappings: [
          {
            name: "mmio",
            type: "device",
            start_address: 0x40000000,
            size_bytes: 0x10000000,
          }
        ],
        objects: [
            {
              name: "CRYPTOLIB",
              type: "channel_handler",
            }
        ],
        threads: [
          {
            name: "crypto_server",
            stack_size_bytes: 2048,
          },
        ],
      },
    },

    {
      name: "crypto_user",
      flash_size_bytes: 16384, // 16K
      ram_size_bytes: 12288,    // 4K
      process: {
        name: "crypto user",
        objects: [
            {
              name: "CRYPTOLIB",
              type: "channel_initiator",
              handler_app: "cryptolib",
              handler_object_name: "CRYPTOLIB",
            },
        ],
        threads: [
          {
            name: "crypto user",
            stack_size_bytes: 2048,
          },
        ],
      },
    },

  ],
}
