load("@rules_rust//rust:defs.bzl", "rust_library")
load("//target/earlgrey:defs.bzl", "TARGET_COMPATIBLE_WITH")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "client",
    srcs = [
        "lib.rs",
        "aes.rs",
        "backend.rs",
        "drbg.rs",
        "ecdsa.rs",
        "hmac.rs",
        "sha2.rs",
        "util.rs",
        "util/asymmetric.rs",
        "util/symmetric.rs",
        "util/digest.rs",
        "util/drbg.rs",
        "util/hmac.rs",
    ],
    crate_name = "crypto_client",
    edition = "2024",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//util/ipc",
        "//crypto/traits",
        "//crypto/common",
        "//util/misc",
        "//target/earlgrey/cryptolib:otcrypto",
        "@pigweed//pw_kernel/syscall:syscall_user",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_status/rust:pw_status",
        "@pigweed//pw_log/rust:pw_log",
        "@rust_crates//:zerocopy",
    ],
    proc_macro_deps = [
        "@rust_crates//:paste",
    ],
)
